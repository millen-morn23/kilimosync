# KilimoSync — environment variables
# Copy to .env.local for development. NEVER commit a file with real values.

# ── Supabase ────────────────────────────────────────────────────────────
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-side only. NEVER prefix with NEXT_PUBLIC_,
# never import outside src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── M-PESA Daraja (server-side only) ───────────────────────────────────
# Start with sandbox credentials from https://developer.safaricom.co.ke/.
# Production and sandbox credentials must never be mixed in the same
# environment. See docs/M-PESA.md.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# ── AI (server-side only) ──────────────────────────────────────────────
# Used by KilimoSync AI's server-side tool-calling layer. Never exposed to
# the browser. See docs/AI.md.
ANTHROPIC_API_KEY=
